# Copy this to .env for local development. On Railway, don't upload a .env
# file - set these as environment variables in the project's Variables tab
# instead (Settings a step below in the README covers exactly where).

# Shared secret for the admin endpoints (POST/GET /api/v1/admin/...).
# This is placeholder-level auth (one static key checked against the
# X-Admin-Key header) - fine while it's just you hitting the API directly,
# but swap it for something real before anyone else has access to it.
ADMIN_API_KEY=changeme-admin-key

# Stripe - placeholders are fine until you're ready to actually process
# real subscriptions. The backend runs fine with these; card/webhook
# events just won't be real until you swap in live keys from your Stripe
# dashboard (Developers > API keys, and Developers > Webhooks for the
# signing secret once you've added this URL as an endpoint there).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# How long a device can go without a successful check-in, or a customer can
# sit in "payment failed" grace, before the display flips to Failed.
OFFLINE_CAP_HOURS=24
GRACE_HOURS=24

# Defaults to a local SQLite file if unset - fine to start. If you add a
# Postgres plugin on Railway later, set this to its connection string
# instead and nothing else in the code needs to change.
# DATABASE_URL=sqlite:///./table_tent.db
